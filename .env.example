# === UPSTASH REDIS (required for auth + sync) ===
# Get free DB at https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# === SESSIONS (required in production) ===
# Random secret used to sign login session cookies. Generate one with:
#   openssl rand -base64 32
# Without this set, production logins will fail closed (no forgeable sessions).
SESSION_SECRET=

# === RESEND (required for real password-reset emails) ===
# Free tier at https://resend.com — without this set, the reset code is only
# logged to the server console in development, and reset requests fail in
# production (never sent back to the browser).
RESEND_API_KEY=
RESET_EMAIL_FROM="KnockAI <onboarding@resend.dev>"

# === ANTHROPIC (optional — AI features) ===
ANTHROPIC_API_KEY=sk-ant-...

# === ELEVENLABS (optional — TTS) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=wDsJlOXPqcvIUKdLXjDs

# === GEMINI (optional — JARVIS chat) ===
GEMINI_API_KEY=your_gemini_api_key

# === APP ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
